/* =========================================================
   CODING EXAM RESULTS
========================================================= */

.coding-results-page {
  min-height: 100vh;
  background: #f8fafc;
  color: #0f172a;
  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

.coding-results-header {
  background: #ffffff;
  border-bottom: 1px solid #e2e8f0;
  padding: 22px 32px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.coding-results-header h1 {
  margin: 0;
  font-size: 24px;
}

.coding-results-header p {
  margin: 5px 0 0;
  color: #64748b;
  font-size: 12px;
}

.coding-results-back {
  border: 1px solid #cbd5e1;
  background: #ffffff;
  color: #334155;
  border-radius: 7px;
  padding: 9px 13px;
  cursor: pointer;
}

.coding-results-container {
  max-width: 1300px;
  margin: 0 auto;
  padding: 30px 32px;
}

/* Summary */

.coding-results-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-bottom: 22px;
}

.coding-results-summary-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 9px;
  padding: 18px;
}

.coding-results-summary-card span {
  display: block;
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
}

.coding-results-summary-card strong {
  display: block;
  margin-top: 6px;
  font-size: 24px;
}

/* Table */

.coding-results-table-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  overflow: hidden;
}

.coding-results-table-wrapper {
  overflow-x: auto;
}

.coding-results-table {
  width: 100%;
  border-collapse: collapse;
}

.coding-results-table th {
  background: #f8fafc;
  color: #64748b;
  padding: 12px 16px;
  border-bottom: 1px solid #e2e8f0;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 0.04em;
  text-align: left;
  white-space: nowrap;
}

.coding-results-table td {
  padding: 15px 16px;
  border-bottom: 1px solid #f1f5f9;
  color: #334155;
  font-size: 12px;
  white-space: nowrap;
}

.coding-results-table tr:last-child td {
  border-bottom: none;
}

.coding-results-table tbody tr:hover {
  background: #f8fafc;
}

.candidate-name {
  color: #0f172a;
  font-weight: 650;
}

.candidate-roll {
  color: #64748b;
  font-size: 11px;
}

.result-score {
  font-weight: 750;
  color: #0f172a;
}

.result-percentage {
  font-weight: 700;
  color: #2563eb;
}

.result-status {
  display: inline-flex;
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 9px;
  font-weight: 750;
  text-transform: uppercase;
}

.result-status.submitted,
.result-status.completed {
  background: #dcfce7;
  color: #166534;
}

.result-status.expired,
.result-status.timeout {
  background: #fef3c7;
  color: #92400e;
}

.result-status.in-progress,
.result-status.active {
  background: #dbeafe;
  color: #1d4ed8;
}

.view-result-button {
  border: 1px solid #bfdbfe;
  background: #eff6ff;
  color: #1d4ed8;
  padding: 7px 11px;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 650;
  cursor: pointer;
}

.view-result-button:hover {
  background: #dbeafe;
}

/* Empty */

.coding-results-empty {
  padding: 60px 20px;
  text-align: center;
  color: #64748b;
}

.coding-results-loading {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
}

@media (max-width: 900px) {
  .coding-results-summary {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 600px) {
  .coding-results-header,
  .coding-results-container {
    padding-left: 16px;
    padding-right: 16px;
  }

  .coding-results-summary {
    grid-template-columns: 1fr;
  }
}