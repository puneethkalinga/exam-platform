generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  TERMINATED
  AUTO_SUBMITTED
}

enum SecurityEventType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY_ATTEMPT
  CUT_ATTEMPT
  PASTE_ATTEMPT
  CONTEXT_MENU
  PAGE_LEAVE
}

model Exam {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  duration    Int        // duration in minutes
  cutoff      Float      // percentage
  status      ExamStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions   Question[]
  candidates  Candidate[]
  attempts    Attempt[]
}

model Question {
  id            Int      @id @default(autoincrement())
  examId        Int
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  marks         Float    @default(1)
  category      String?
  difficulty    String?
  order         Int

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers       Answer[]

  @@index([examId])
}

model Candidate {
  id         Int      @id @default(autoincrement())
  name       String
  rollNumber String
  year       String
  section    String
  createdAt  DateTime @default(now())

  examId     Int
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  attempts   Attempt[]

  @@unique([examId, rollNumber])
  @@index([examId])
}

model Attempt {
  id          String        @id @default(cuid())
  candidateId Int
  examId      Int

  startedAt   DateTime?
  submittedAt DateTime?
  score       Float         @default(0)
  percentage  Float         @default(0)
  status      AttemptStatus @default(NOT_STARTED)

  candidate   Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)

  answers     Answer[]
  securityEvents SecurityEvent[]

  @@index([candidateId])
  @@index([examId])
  @@index([status])
}

model Answer {
  id             Int      @id @default(autoincrement())
  attemptId      String
  questionId     Int
  selectedAnswer String?
  isCorrect      Boolean  @default(false)
  marksObtained  Float    @default(0)
  answeredAt     DateTime @default(now())

  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model SecurityEvent {
  id             Int               @id @default(autoincrement())
  attemptId      String
  eventType      SecurityEventType
  questionNumber Int?
  metadata       String?
  createdAt      DateTime          @default(now())

  attempt        Attempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([eventType])
}